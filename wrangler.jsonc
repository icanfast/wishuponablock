{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "wishuponablock",
	"compatibility_date": "2026-02-05",
	"main": "./src/entry/worker.ts",
	"vars": {
		"RELEASE_CHANNEL": "local",
		"FEATURE_FLAGS": "{}",
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wishuponablock",
			"database_id": "eac41a1a-239a-49d2-ae56-06a0464447ee",
			"migrations_dir": "./tools/db/migrations",
		},
	],
	"env": {
		"dev": {
			"name": "wishuponablock-030-dev",
			"vars": {
				"RELEASE_CHANNEL": "dev",
				"FEATURE_FLAGS": "{\"computeProfiler\":false,\"rlPipeline\":false,\"authV1\":false,\"dbV3\":false}",
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "wishuponablock",
					"database_id": "eac41a1a-239a-49d2-ae56-06a0464447ee",
					"migrations_dir": "./tools/db/migrations",
				},
			],
			"r2_buckets": [
				{
					"bucket_name": "wishuponablock-dev-models",
					"binding": "MODELS_BUCKET",
					"remote": true
				},
				{
					"bucket_name": "wishuponablock-dev-recordings",
					"binding": "RECORDINGS_BUCKET",
					"remote": true
				}
			]
		},
	}
}
